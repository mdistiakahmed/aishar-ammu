# Copy to .env.local for vinext, or .dev.vars for Cloudflare local bindings.
# Keep secrets out of this file.
# Create an OAuth client in Google Cloud Console (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Production redirect URI: https://<your-domain>/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra Google OAuth client ids (iOS/Android), comma-separated.
# GOOGLE_CLIENT_IDS=

# Optional. Use this if the public site URL differs from the request origin.
# AUTH_URL=https://example.com

# D1 is bound as DB in wrangler.jsonc.
# Apply schema locally: npm run db:migrate:local
# Apply schema in Cloudflare: npm run db:migrate
